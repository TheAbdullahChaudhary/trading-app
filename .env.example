# Copy this file to .env and fill in your credentials
# MEXC API: https://www.mexc.com/user/openapi
# Enable "Trade" + "Contract Trade" permissions

MEXC_API_KEY=your_mexc_api_key_here
MEXC_API_SECRET=your_mexc_api_secret_here

# Optional: Gemini AI Analyst (get free key at https://aistudio.google.com/app/apikey)
# If not set, the bot uses rule-based analysis (fully functional without this)
GEMINI_API_KEY=your_gemini_api_key_here
